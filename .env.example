# ==============================================================================
# CẤU HÌNH - copy file này thành .env rồi điền giá trị thật
#   Windows : copy .env.example .env
#   Linux/Mac: cp .env.example .env
# File .env đã được thêm vào .gitignore, KHÔNG BAO GIỜ commit lên GitHub.
# ==============================================================================

# API key Roboflow (lấy tại https://universe.roboflow.com -> Settings -> API Key)
# LƯU Ý: key cũ đã bị lộ trong lịch sử Git, hãy REVOKE/ROTATE ngay trên Roboflow.
ROBOFLOW_API_KEY=

# --- Hiệu chuẩn ROI & ngưỡng ùn tắc (để trống = dùng mặc định trong config.py) ---
# Đoạn đường trong ROI phụ thuộc camera; đặt đúng thì mật độ xe/km mới đúng.
#   ROI_REAL_LENGTH_M: chiều dài theo hướng xe chạy (m), ví dụ 60.0
#   ROI_REAL_WIDTH_M:  rộng mặt đường (m), ví dụ 12.0
#   DENSITY_THRESHOLDS / OCCUPANCY_THRESHOLDS: ngưỡng L2,L3,L4 cách nhau dấu phẩy
#   PCU_WEIGHTS: trọng số xe máy,ô tô,khách,tải, ví dụ 0.5,1.0,2.5,2.0
#   VN_FONT_PATH: đường dẫn font TTF có dấu (mặc định tự tìm Arial/DejaVu)
# ROI_REAL_LENGTH_M=
# ROI_REAL_WIDTH_M=
# DENSITY_THRESHOLDS=
# OCCUPANCY_THRESHOLDS=
# PCU_WEIGHTS=
# --- Nhận diện đa tầm: vớt xe gần to + xe xa nhỏ (không cần sửa code) ---
# Lượt chính cố định theo conf người dùng; lượt recall bật/tắt bằng DET_RECALL_PASS.
DET_IMGSZ=1280
DET_IOU=0.5
DET_MAX_DET=300
DET_AGNOSTIC_NMS=1
DET_RECALL_PASS=1
DET_RECALL_CONF=0.10
DET_RECALL_IMGSZ=960
DET_RECALL_PAD=0.10
DET_MERGE_IOU=0.45
# VN_FONT_PATH=